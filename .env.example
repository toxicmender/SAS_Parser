# Sample environment for SAS_Parser — copy to `.env` and fill in.
#
#   cp .env.example .env      # (.env is gitignored; never commit real values)
#
# demo_run.py auto-loads `.env` from the repo root (via python-dotenv) at
# startup; real shell environment variables still win over the file. These are
# the variables app_config.vault and demo_run.py read. Non-secret Vault knobs
# (mount_point, kv_version, timeout, verify) live in the `vault` section of
# config.json, not here.

# ---------------------------------------------------------------------------
# LLM API key — the direct (no-Vault) path
# ---------------------------------------------------------------------------
# Used when demo_run.py is run WITHOUT --vault-secret. Ignored when the key is
# fetched from Vault instead. The AI Gateway speaks the OpenAI protocol for
# every model it fronts (Claude and Gemini included), so this is the variable
# whatever --model names.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: the gateway endpoint, when it is not set in config.json
# (llm_client.base_url) or carried by the Vault secret.
# OPENAI_BASE_URL=https://llm-gateway.example/v1
# The gateway's protocol version, sent as the `ai-gateway-version` header on
# every request. Also settable as llm_client.gateway_version in config.json, or
# carried by the Vault AI Gateway secret.
#LLM_GATEWAY_VERSION=v2

# ---------------------------------------------------------------------------
# Vault connection (non-secret) — standard HashiCorp env vars
# ---------------------------------------------------------------------------
# Address wins over config.json vault.address; required to reach Vault.
VAULT_ADDR=https://vault.example:8200
# Vault Enterprise namespace; leave unset for open-source / root namespace.
#VAULT_NAMESPACE=team-sas
# TLS: path to a CA bundle to trust, or set VAULT_SKIP_VERIFY=true to disable
# verification (DEV ONLY — never in production).
#VAULT_CACERT=/etc/ssl/vault-ca.pem
#VAULT_SKIP_VERIFY=false
# The application's name in Vault — one value playing three parts: the role
# name for `azuread` login, the KV secret-path prefix (so the AI Gateway
# credential is at `<app_name>/ai_gateway`), and the app's own name. Setting it
# is what enables `azuread` login; it is not a credential.
#VAULT_APP_NAME=udap_scripts_udappipelines_comp_dev.appsvc102630
# Audience for the Entra ID JWT presented at that login (space- or
# comma-separated). Unset requests Azure Resource Manager, which is what a role
# bound to the ARM audience expects.
#VAULT_AZURE_SCOPES=https://management.azure.com//.default

# ---------------------------------------------------------------------------
# Vault auth — pick ONE method (secrets: keep out of source control)
# ---------------------------------------------------------------------------
# AppRole (app-based auth) — what demo_run.py --vault-secret uses. The app
# authenticates as its own identity with a role_id / secret_id pair.
VAULT_ROLE_ID=00000000-0000-0000-0000-000000000000
VAULT_SECRET_ID=00000000-0000-0000-0000-000000000000

# Token auth — an alternative to AppRole for the library's from_env() path.
# (demo_run.py deliberately ignores this and forces AppRole.) Uncomment to use.
#VAULT_TOKEN=hvs.xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Microsoft Entra ID (Azure AD) — app_config.azure
# ---------------------------------------------------------------------------
# The identity that mints the JWT for Vault's `azuread` login and the Graph
# token for SharePoint. Left unset, it is read from the Databricks secret scope
# (DATABRICKS_SECRET_SCOPE) instead. Only the secret belongs here; the
# non-secret knobs may live in the `azure` section of config.json.
#AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
#AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
#AZURE_CLIENT_SECRET=your-entra-client-secret
# TLS verification for the Entra ID call itself: `false` to disable (DEV ONLY),
# or a path to a CA bundle. On a TLS-intercepting network this is what makes
# the token request succeed — without it the login fails before Vault is ever
# contacted. Unset inherits the Vault setting (VAULT_CACERT /
# VAULT_SKIP_VERIFY / vault.verify), since one bundle normally covers both legs.
#AZURE_VERIFY=/etc/ssl/corporate-ca.pem

# ---------------------------------------------------------------------------
# SharePoint (Microsoft Graph) — app_config.sharepoint
# ---------------------------------------------------------------------------
# No secrets here. On a real deployment SharePoint authenticates as its OWN
# service principal, read from the Databricks secret scope under keys of its
# own (see SHAREPOINT_SECRET_SCOPE below); locally it falls back to the Entra ID
# service principal above (AZURE_TENANT_ID / AZURE_CLIENT_ID /
# AZURE_CLIENT_SECRET). Either app registration needs the Graph application
# permission Sites.ReadWrite.All granted with admin consent. Non-secret knobs
# (drive_id, scopes, timeout) may instead live in the `sharepoint` section of
# config.json.
# Identify the site with SHAREPOINT_SITE_ID, or the hostname + path pair:
#SHAREPOINT_SITE_HOSTNAME=contoso.sharepoint.com
#SHAREPOINT_SITE_PATH=/sites/Engineering
#SHAREPOINT_SITE_ID=contoso.sharepoint.com,00000000-0000-0000-0000-000000000000,00000000-0000-0000-0000-000000000000
# Target a specific document library; omit to use the site's default library:
#SHAREPOINT_DRIVE_ID=b!xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The applications root inside that library. A leading "Shared Documents/" is
# stripped for you — Graph addresses items inside the library, so a folder of
# that literal name does not exist.
#SHAREPOINT_FILE_SERVER_BASE_PATH=Shared Documents/Script Migration and Conversion Kit/Applications
# The Databricks secret scope holding the SharePoint service principal, and the
# keys it is filed under. The scope defaults to DATABRICKS_SECRET_SCOPE and the
# keys to saact-hsv-tenantid / saact-hsv-appid / saact-hsv-secret, which is what
# the reference deployment uses — set these only if yours differs.
#SHAREPOINT_SECRET_SCOPE=udap_scripts_udappipelines_comp_APPSVC102630_dev
#SHAREPOINT_TENANT_ID_KEY=saact-hsv-tenantid
#SHAREPOINT_CLIENT_ID_KEY=saact-hsv-appid
#SHAREPOINT_CLIENT_SECRET_KEY=saact-hsv-secret
# The lists the run is driven by (Graph list ids, or display names).
#SHAREPOINT_LIST_ID_SAS_REQUESTS=00000000-0000-0000-0000-000000000000
#SHAREPOINT_LIST_ID_SAS_CONVERSIONS=00000000-0000-0000-0000-000000000000
#SHAREPOINT_LIST_ID_XREF=00000000-0000-0000-0000-000000000000
#SHAREPOINT_LIST_ID_SAS_COMPLEXITY=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------------
# XREF dataset-name substitution — the `xref` package
# ---------------------------------------------------------------------------
# When the SharePoint XREF mappings are applied: `pre` (default) rewrites SAS
# dataset names before conversion, `post` rewrites the generated code, `both`
# does each and reports what only one of them reached. Also settable as
# xref.apply in config.json.
#XREF_APPLY=pre

# ---------------------------------------------------------------------------
# Optional: point at an alternative config.json (app_config loader)
# ---------------------------------------------------------------------------
#SAS_PARSER_CONFIG=/path/to/config.json

# ---------------------------------------------------------------------------
# Docker Compose stack (docker-compose.yml) — ignored outside it
# ---------------------------------------------------------------------------
# Compose substitutes these when building/starting the local Vault + Spark
# stack; see docker/README.md for the full list and defaults. The container's
# own VAULT_ADDR / VAULT_ROLE_ID / VAULT_SECRET_ID are set by compose and by
# the vault-init service, NOT from here — the values above are for bare-metal
# runs and are deliberately overridden inside the stack.
#VAULT_DEV_ROOT_TOKEN_ID=root      # dev Vault's root token
# The AppRole identity the dev stack pins and hands the app container. Dev
# constants, not secrets — the real ones above are for bare-metal runs.
#DEV_VAULT_ROLE_ID=11111111-1111-1111-1111-111111111111
#DEV_VAULT_SECRET_ID=22222222-2222-2222-2222-222222222222
#VAULT_VERSION=1.18                # hashicorp/vault image tag
#PYSPARK_VERSION=4.1.2             # cluster Spark version; keep equal to uv.lock
#SPARK_WORKER_CORES=2
#SPARK_WORKER_MEMORY=2g
#WITH_DELTA=1                      # 0 builds the images without Delta Lake
# A real Databricks workspace (nothing local stands in for the workspace APIs):
#DATABRICKS_HOST=https://adb-0000000000000000.0.azuredatabricks.net
# (a personal access token; the literal shape `dapi<32 hex>` is omitted here
# because secret scanners flag even an obviously-fake one)
#DATABRICKS_TOKEN=your-databricks-pat
# `token` (lowercase) is the reference deployment's spelling of the same PAT and
# is read as a fallback, so a .env written for it works here unchanged.
# DATABRICKS_TOKEN wins when both are set.
#token=your-databricks-pat
#DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/0000000000000000
