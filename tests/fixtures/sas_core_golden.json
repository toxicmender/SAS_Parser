  "sources": {
    "01_build.sas": "options mprint;\n%let region=west;\n%macro build(src,out);\ndata &out.;\n  set &src.;\n  if amount > 0;\nrun;\n%mend build;\ndata work.raw;\n  set ext.orders;\nrun;\n%build(src=work.raw,out=work.clean);\n",
